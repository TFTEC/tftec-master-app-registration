# =====================================================
# Variáveis do Frontend (Vite)
# =====================================================
# Copie este arquivo para .env.local e preencha com SEUS valores.
# .env.local é gitignored — nunca vai subir pro repositório.
#
# Onde obter cada valor:
#   1. Crie sua App Registration no Azure Portal
#      → docs/guides/app-registration-setup.md  (passo a passo completo)
#   2. Anote o Application (client) ID
#   3. Use os valores abaixo
# =====================================================

# Application (client) ID da SUA App Registration
# Obtém em: Portal → Microsoft Entra ID → App registrations → sua app → Overview
VITE_AZURE_CLIENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Tenant ID — use "organizations" para multi-tenant (recomendado)
# OU seu tenant específico: xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# OU "common" para qualquer conta Microsoft (incluindo pessoais)
VITE_AZURE_TENANT_ID=organizations

# Audience — sempre api://<seu-client-id>
# Configure em: Portal → sua App Reg → Expose an API → Application ID URI
VITE_AZURE_AUDIENCE=api://xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# URL do AuthService API (backend .NET)
# Local:    http://localhost:8080
# Produção: https://<seu-app-service>.azurewebsites.net
VITE_AUTHSERVICE_URL=http://localhost:8080
