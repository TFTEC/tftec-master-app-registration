{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.Identity": "Warning"
    }
  },
  "AzureAd": {
    "Instance": "https://login.microsoftonline.com/",
    "TenantId": "organizations",
    "ClientId": "REPLACE_WITH_YOUR_CLIENT_ID",
    "ClientSecret": "SET_VIA_ENV_OR_KEYVAULT",
    "Audience": "api://REPLACE_WITH_YOUR_CLIENT_ID"
  },
  "AllowedTenants": {
    "AllowAll": true,
    "TenantIds": []
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173",
      "http://localhost:3000"
    ]
  },
  "InternalJwt": {
    "Issuer": "AuthService",
    "Audience": "AuthService-Clients",
    "SigningKey": "SET_VIA_ENV_OR_KEYVAULT",
    "ExpiryMinutes": 60
  },
  "DownstreamApis": {
    "Apis": {
      "ApiA": {
        "BaseUrl": "https://api-a.example.com",
        "Scopes": ["api://api-a-client-id/access_as_user"],
        "ClientId": "api-a-client-id"
      },
      "ApiB": {
        "BaseUrl": "https://api-b.example.com",
        "Scopes": ["api://api-b-client-id/.default"],
        "ClientId": "api-b-client-id"
      }
    }
  },
  "Redis": {
    "ConnectionString": "",
    "InstanceName": "AuthService:",
    "DefaultTtlMinutes": 60
  },
  "ServiceBus": {
    "ConnectionString": "",
    "TopicName": "topic-app-events"
  }
}
